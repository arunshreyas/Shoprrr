// use prisma-8

enum TxType {
  UDHAAR
  JAMA
}

model Shop {
  id           String        @id @onCreate(cuid(2))
  shopName     String
  location     String?
  ownerPhone   String?
  isDemo       Boolean       @default(false)
  customers    Customer[]
  transactions Transaction[]
  createdAt    temporal.CreatedAt

  @@rls
}

model Customer {
  id            String        @id @onCreate(cuid(2))
  shopId        String
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  tag           String?
  phone         String?
  reminderOptIn Boolean       @default(false)
  transactions  Transaction[]
  createdAt     temporal.CreatedAt

  @@unique([shopId, name, tag])
  @@index([shopId, name])
  @@rls
}

model Transaction {
  id              String        @id @onCreate(cuid(2))
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            TxType
  amount          Decimal(precision: 12, scale: 2)
  notes           String?
  transactionDate DateTime      @default(now())
  isReverted      Boolean       @default(false)
  replacesTxId    String?
  replacesTx      Transaction?  @relation("TxReplacement", fields: [replacesTxId], references: [id], onDelete: SetNull)
  replacedBy      Transaction[] @relation("TxReplacement")
  createdAt       temporal.CreatedAt

  @@index([shopId, createdAt])
  @@index([shopId, customerId, transactionDate])
  @@index([customerId, transactionDate])
  @@index([replacesTxId])
  @@rls
}
